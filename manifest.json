{
    "manifest_version": 3,
    "name": "Google Meet Free Recorder",
    "version": "1.0",
    "description": "Record Google Meet sessions with tab and microphone audio without limits.",
    "permissions": [
        "activeTab",
        "tabCapture",
        "downloads",
        "storage",
        "scripting"
    ],
    "web_accessible_resources": [
  {
    "resources": ["logo.png"],
    "matches": ["<all_urls>"]
  }
],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ]
}